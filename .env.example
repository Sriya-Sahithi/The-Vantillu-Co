# ---------- Public (safe to expose to the browser) ----------
# International format, digits only (no leading +).
NEXT_PUBLIC_WHATSAPP_NUMBER=919441343257
# Public production URL, no trailing slash. Used for canonical URLs and links in emails.
NEXT_PUBLIC_SITE_URL=https://example.com
# Optional Google Tag Manager container.
# NEXT_PUBLIC_GTM_ID=

# ---------- Server-only secrets (NEVER prefix with NEXT_PUBLIC_, never commit) ----------
# Postgres connection string. For Supabase use the *pooled* (Supavisor, port 6543) URI, e.g.
# postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
DATABASE_URL=
# Optional: PEM CA certificate (use \n for newlines) to fully verify the DB TLS certificate.
# DATABASE_CA_CERT=
# Connections per serverless instance (keep small on Vercel).
# DATABASE_POOL_MAX=3

# Razorpay (Dashboard -> Account & Settings -> API Keys). Use rzp_test_* keys until go-live.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Webhook secret you choose when creating the webhook (Dashboard -> Webhooks). Different from the key secret.
RAZORPAY_WEBHOOK_SECRET=

# Random secret (>= 32 chars) used to sign guest order links and hash one-time codes.
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=

# Email (Resend: https://resend.com). EMAIL_FROM must be on a domain verified in Resend.
RESEND_API_KEY=
EMAIL_FROM="The Vantillu Co. <orders@your-domain.example>"
# Optional: receives a message for every newly paid order.
# ADMIN_NOTIFY_EMAIL=

# Comma-separated emails that become the owner admin on first sign-in with a one-time code.
ADMIN_BOOTSTRAP_EMAILS=

# Secret Vercel Cron sends as "Authorization: Bearer <CRON_SECRET>" to /api/cron/maintenance.
CRON_SECRET=
